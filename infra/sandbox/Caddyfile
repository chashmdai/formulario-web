{
    admin off
    auto_https off
    persist_config off
    https_port 8443
    servers {
        protocols h1 h2
        strict_sni_host on
    }
    log {
        output discard
    }
}

https://claveunica.formularioadulto.defensorianinez.gob.cl {
    tls /run/siger/site.pem /run/siger/site-key.pem {
        protocols tls1.2 tls1.3
    }
    reverse_proxy app:8080 {
        header_up -Forwarded
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host claveunica.formularioadulto.defensorianinez.gob.cl
        header_up X-Forwarded-Port 443
        header_up X-Forwarded-For {http.request.remote.host}
    }
    # No access log: ni códigos del callback, ni cookies, ni identidad.
}
