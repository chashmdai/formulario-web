# Fragmento para una instalación PRIVADA NUEVA; jamás copiar al despliegue de certificación.
# Todos los gates requieren aprobación documentada independiente. No contiene identidades consultables.
PISEE_SRCEI_ENABLED=false
PISEE_ENVIRONMENT=PRODUCTION
PISEE_PRODUCTION_AUTHORIZED=false
PISEE_LEGAL_BASIS_APPROVED=false
PISEE_PURPOSE=REGISTRO DE USUARIOS
PISEE_BASE_URL=http://pisee:8084
PISEE_TIMEOUT_MS=15000
PISEE_CONCURRENCY=2
PISEE_ALLOWED_RUNS_PATH=/run/pisee-campaign/allowed-runs.json
PISEE_X509_CERTIFICATE_PATH=/run/pisee/public.pem
PISEE_X509_SHA256=3dc48ca30f6894d3321da10173af47960d5fe9afdbbd769696f1e6de678a64e0
# No hay cabecera local inventada: el nodo institucional validado no la exige.
# PISEE_LOCAL_AUTHORIZATION_PATH solo si el wrapper revisado la requiere realmente.
# Un recorrido con datos registrales tampoco puede enviarse por apagar PISEE.
formulario.srcei.envio-autorizado=false
formulario.srcei.envio-sintetico-autorizado=false
