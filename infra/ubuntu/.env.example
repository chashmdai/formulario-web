# Copiar FUERA de Git. No contiene contraseñas; Compose exige ficheros secretos.
COMPOSE_PROJECT_NAME=ddn-formulario-candidato
FORM_PRIVATE_DIR=/srv/ddn-formulario-candidato
FORM_HOSTNAME=formulario.defensorianinez.gob.cl
FORM_HTTPS_PORT=24443
# Sustituir COMMIT por el SHA candidato publicado; no usar latest.
FORM_SOURCE_REVISION=COMMIT
FORM_IMAGE=ddn-formulario:COMMIT
INSPECTOR_IMAGE=ddn-inspector:COMMIT
ANTIVIRUS_IMAGE=ddn-clamav:COMMIT
PROXY_IMAGE=ddn-caddy:COMMIT
