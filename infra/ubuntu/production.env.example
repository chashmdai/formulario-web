FORM_HOSTNAME=REEMPLAZAR_HOSTNAME_AUTORIZADO.gob.cl
FORM_HTTPS_PORT=REEMPLAZAR_PUERTO_LOOPBACK_LIBRE
FORM_SOURCE_REVISION=REEMPLAZAR_SHA_RC1
FORM_IMAGE=REEMPLAZAR_IMAGEN_POR_DIGEST
MYSQL_IMAGE=REEMPLAZAR_MYSQL_POR_DIGEST
PROXY_IMAGE=REEMPLAZAR_CADDY_POR_DIGEST
INSPECTOR_IMAGE=REEMPLAZAR_INSPECTOR_POR_DIGEST
ANTIVIRUS_IMAGE=REEMPLAZAR_CLAMAV_POR_DIGEST
PISEE_IMAGE=REEMPLAZAR_NODO_POR_DIGEST
PISEE_PRIVATE_DIR=/srv/ddn-formulario-definitivo/pisee
