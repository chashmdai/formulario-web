{
    admin off
    auto_https off
    # Origen real del ciudadano: CF-Connecting-IP lo fija el borde de Cloudflare y solo se acepta si el par TCP
    # inmediato es el proxy autorizado (cloudflared en el anfitrión, visto como la puerta de enlace de la red salida).
    # Sin FORM_TRUSTED_PROXIES no se confía en ningún par: cada solicitud usa su dirección TCP.
    servers {
        trusted_proxies static {$FORM_TRUSTED_PROXIES:127.0.0.1/32}
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP
    }
    # Evitar que errores de transporte registren query OAuth/cabeceras de sesión.
    log default {
        output discard
    }
}
(backend) {
    reverse_proxy https://app:8443 {
        header_up Host {$FORM_HOSTNAME}
        header_up -Forwarded
        # Cabecera interna sobrescrita en cada solicitud: un valor enviado por el cliente nunca llega al backend.
        header_up X-Ddn-Client-Ip {client_ip}
        header_up X-Forwarded-Host {$FORM_HOSTNAME}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Port 443
        transport http {
            tls_server_name app
            tls_trust_pool file /run/pki/ca.crt
        }
    }
}
:8443 {
    tls /run/pki/server.crt /run/pki/server.key
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
    route {
        @wrongHost not host {$FORM_HOSTNAME} localhost
        respond @wrongHost "Origen no autorizado" 421
        # Administración solo por red backend privada y credencial separada.
        @private path /operacion /operacion/* /actuator /actuator/* /admin /admin/*
        respond @private "Servicio no disponible" 503
        @bloque {
            method PUT
            path /api/formulario/recorridos/*/cargas/*/bloques/*
        }
        handle @bloque {
            request_body {
                max_size 8MiB
            }
            import backend
        }
        handle {
            request_body {
                max_size 26MiB
            }
            import backend
        }
    }
}
