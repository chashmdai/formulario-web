# Configuración PRIVADA del candidato. Recepción y PULL comienzan cerrados en BD.
spring.profiles.active=jdbc-reception
server.address=0.0.0.0
server.port=8443
server.ssl.enabled=true
server.ssl.key-store=/run/pki/server.p12
server.ssl.key-store-type=PKCS12
server.servlet.session.cookie.secure=true
server.forward-headers-strategy=none
# Activación temporal explícita; ficheros fuera de Git e imágenes.
formulario.acceso-temporal.habilitado=false
formulario.acceso-temporal.expira=2026-12-15T00:00:00-03:00[America/Santiago]
formulario.acceso-temporal.hash-path=/run/keys/acceso-temporal-password.hash
formulario.acceso-temporal.apertura-path=/run/keys/acceso-temporal-apertura.json
formulario.acceso-temporal.limites-path=/var/lib/acceso-temporal/limites.json
publico.db.url=jdbc:mysql://mysql:3306/formulario_publico?sslMode=VERIFY_IDENTITY&connectTimeout=5000&socketTimeout=30000
publico.db.user=formulario_app
publico.db.pool=8
datos.mysql-local=false
publico.recepcion.habilitada=false
publico.recepcion.aviso-validado=false
# Recepción durable independiente del despliegue Windows, solo con autorización expresa.
publico.recepcion.custodia-durable-autorizada=false
publico.recepcion.aviso-version=ADULTO_20261031_1
publico.nna.habilitado=false
formulario.habilitado=true
formulario.adultos.habilitado=false
formulario.recepcion.habilitada=false
formulario.aviso-adulto=ADULTO_20261031_1
formulario.aviso-nna=NNA_20261031_1
formulario.abuso-key-path=/run/keys/abuso.key
publico.comprobante.key-id=publico-candidato
publico.comprobante.private-key=/run/keys/receipt-key.pem
publico.comprobante.trusted-keys=/run/keys/receipt-trust.json
publico.comprobante.institutional-trusted-keys=/run/keys/institutional-trust.json
publico.integracion.habilitada=true
# Autentica rutas aun con integración cerrada, sin permitir reservas/recepción/ACK.
publico.integracion.preparada=true
siger.claveunica.habilitada=true
siger.claveunica.environment=PRODUCTION
siger.claveunica.public-origin=https://formulario.defensorianinez.gob.cl
siger.claveunica.redirect-uri=https://formulario.defensorianinez.gob.cl/redirect
siger.claveunica.logout-uri=https://formulario.defensorianinez.gob.cl/logout
siger.claveunica.id-token-algorithm=HS256
siger.claveunica.callback-approved=true
PISEE_SRCEI_ENABLED=false
# Correo y notificaciones corresponden a SIGER; no son requisitos del Formulario.
formulario.adjuntos.clamav-host=antivirus
formulario.adjuntos.clamav-port=3310
# Perfil inspeccionado preparado: NO habilita recepción ciudadana.
formulario.multimedia.habilitada=true
formulario.multimedia.directorio=/var/lib/formulario
formulario.multimedia.antivirus-socket=/ipc/antivirus/clamd.sock
formulario.multimedia.antivirus-config=/run/config/clamd.conf
formulario.multimedia.inspector-socket=/ipc/inspector/inspector.sock
formulario.multimedia.cuota-global=10GB
formulario.multimedia.minimo-libre=2GB
capacidad.minimo-libre=4GB
ciclo-vida.online-habilitado=false
ciclo-vida.eliminacion.habilitada=false
ciclo-vida.modalidad=GARANTIA_INDEPENDIENTE
ciclo-vida.ack-riesgo-aceptado=false
