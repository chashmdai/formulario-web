[Unit]
Description=Respaldo diario del Formulario (America/Santiago)

[Timer]
# Mantener DESHABILITADO: requiere decisión operacional tras revisar capacidad/copia externa.
OnCalendar=*-*-* 03:15:00 America/Santiago
RandomizedDelaySec=300
Persistent=true
Unit=ddn-formulario-produccion-backup.service

[Install]
WantedBy=timers.target
