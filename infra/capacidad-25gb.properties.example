# Receptor transitorio de 25 GB: candidato SIN activar en laboratorios existentes.
formulario.multimedia.cuota-global=6144MB
formulario.multimedia.minimo-libre=4096MB
# También cierra nuevas recepciones sin adjuntos y nuevas identificaciones si falta espacio.
capacidad.minimo-libre=4096MB

# Dos seguros independientes. El programador no existe hasta habilitar el primero.
ciclo-vida.online-habilitado=false
ciclo-vida.eliminacion.habilitada=false
ciclo-vida.intervalo=PT5M
ciclo-vida.inicio=PT1M
ciclo-vida.retencion-post-ack=PT24H
ciclo-vida.retencion-abandono=PT48H
ciclo-vida.borradores-metadatos-retencion=P7D
ciclo-vida.auditoria-tecnica-retencion=P30D
ciclo-vida.garantias.trusted-keys=/run/secrets/garantias-public-keys.json

# Reutilizar las rutas privadas existentes de firma/confianza, abuso y almacén.
# No se monta el archivo SIGER ni una base institucional en el servidor público.
# La garantía llega por HTTPS desde el agente institucional.